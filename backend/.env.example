# SmartCloud Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it's in .gitignore for security.

# ═════════════════════════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION (Required)
# ═════════════════════════════════════════════════════════════════════════════
# Get these from https://app.supabase.com → Project → Settings → API

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE KEY (secret — backend only, never expose to frontend)
# Use this for server-side operations that bypass RLS
SUPABASE_KEY=sb_service_role_key_here

# PostgreSQL direct connection (optional, for direct database access)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartcloud

# ═════════════════════════════════════════════════════════════════════════════
# LOCAL LLM CONFIGURATION (RECOMMENDED)
# ═════════════════════════════════════════════════════════════════════════════
# Use local Ollama for privacy, speed, and zero API costs.
# Default: true (uses local Ollama if available)
# Set to false to fall back to OpenRouter

USE_LOCAL_LLM=true

# Ollama configuration (only used if USE_LOCAL_LLM=true)
# Start Ollama with: ollama serve
# Download model with: ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embedding model for semantic search (runs locally)
# Options: all-MiniLM-L6-v2 (fast, 384-dim), all-mpnet-base-v2 (better, 768-dim)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ═════════════════════════════════════════════════════════════════════════════
# FALLBACK: OpenRouter API (used if Ollama unavailable or USE_LOCAL_LLM=false)
# ═════════════════════════════════════════════════════════════════════════════
# Get free API key at https://openrouter.ai
# Only needed if USE_LOCAL_LLM=false

LLM_API_KEY=sk-or-v1-your-api-key-here
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# ═════════════════════════════════════════════════════════════════════════════
# PAYMENT PROCESSOR: RAZORPAY (Optional for local development)
# ═════════════════════════════════════════════════════════════════════════════
# Get these from https://dashboard.razorpay.com → Settings → API Keys

# Razorpay Key ID (public, safe to expose)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret (KEEP SECRET — backend only, never expose to frontend)
# Switch to live keys in production at https://dashboard.razorpay.com
RAZORPAY_KEY_SECRET=your_secret_key_here

# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION (for CORS)
# ═════════════════════════════════════════════════════════════════════════════
# URL of the Next.js frontend (for CORS allow_origins)
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000
